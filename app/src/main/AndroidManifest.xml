<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:label="Smart Pantry Manager"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartPantryManager"
        tools:ignore="MissingApplicationIcon">

        <!-- Add/Edit Ingredient screen -->
        <activity
            android:name=".ui.AddEditIngredientActivity"
            android:exported="false" />

        <!-- Recipe Suggestions screen -->
        <activity
            android:name=".ui.SuggestedRecipesActivity"
            android:exported="false" />

        <!-- Recipe Detail screen -->
        <activity
            android:name=".ui.RecipeDetailActivity"
            android:exported="false" />

        <!-- Settings screen -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />

        <!-- Main Pantry screen -->
        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>
